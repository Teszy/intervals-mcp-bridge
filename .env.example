# MCP server: Intervals.icu connection settings.
INTERVALS_BASE_URL=https://intervals.icu/api/v1
# Personal API key generated in Intervals.icu Settings > Developer Settings.
INTERVALS_API_KEY=
# Athlete ID is a string, e.g. i123456.
INTERVALS_ATHLETE_ID=0

# OpenAI Secure MCP Tunnel: required only for Docker/ChatGPT.
OPENAI_TUNNEL_ID=
OPENAI_TUNNEL_API_KEY=

# Optional: pin an existing published image version instead of following latest.
# MCP_IMAGE=ghcr.io/teszy/intervals-mcp-bridge:1.2.0
