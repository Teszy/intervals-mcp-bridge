{
  "name": "intervals-mcp-bridge",
  "version": "1.3.0",
  "description": "A lightweight MCP bridge for Intervals.icu training data",
  "keywords": [
    "typescript",
    "pnpm",
    "monorepo"
  ],
  "author": {
    "name": "Balázs Teszár",
    "email": "teszyb@gmail.com"
  },
  "private": true,
  "license": "MIT",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier . --check",
    "test:run": "vitest run --passWithNoTests",
    "test:container": "MCP_TEST_IMAGE=intervals-mcp-bridge:ci-smoke vitest run tests/stdio.test.ts",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm test:compiled",
    "prepare": "husky",
    "check:commit": "pnpm typecheck && pnpm test:run",
    "test:compiled": "MCP_TEST_COMPILED=1 vitest run tests/stdio.test.ts",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\""
  },
  "prettier": {
    "singleQuote": true,
    "semi": true,
    "trailingComma": "all",
    "printWidth": 100
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "packageManager": "pnpm@12.6.0",
  "type": "module",
  "dependencies": {
    "@garmin/fitsdk": "^21.218.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "axios": "^1.20.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "imports": {
    "#app/*.js": {
      "development": "./src/app/*.ts",
      "default": "./dist/src/app/*.js"
    },
    "#http/*.js": {
      "development": "./src/http/*.ts",
      "default": "./dist/src/http/*.js"
    },
    "#intervals/*.js": {
      "development": "./src/intervals/*.ts",
      "default": "./dist/src/intervals/*.js"
    },
    "#mcp/*.js": {
      "development": "./src/mcp/*.ts",
      "default": "./dist/src/mcp/*.js"
    },
    "#shared/*.js": {
      "development": "./src/shared/*.ts",
      "default": "./dist/src/shared/*.js"
    },
    "#errors.js": {
      "development": "./src/errors.ts",
      "default": "./dist/src/errors.js"
    },
    "#package.json": "./package.json"
  }
}
